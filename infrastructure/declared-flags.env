# Declared environment for the Metron box — the ONLY place these values are set
# (metron-ops-I340, metron-ops-I281). deploy-on-merge.sh applies this file on every deploy
# via infrastructure/declared_env.sh:
#
#   NAME=value   written into a managed block in metron/.env, the file every Metron unit
#                reads (metron-api, the release gate, refresh, reconcile, ...). Any
#                hand-set line for NAME in metron/.env or metron-ops/.env is removed and
#                logged, so this file is what the box runs — a rebuild restores it, and a
#                hand edit lasts only until the next deploy.
#   -NAME        retired: every line setting NAME is removed from both env files. The
#                value is never logged.
#
# Non-secret values only. Secrets are hydrated from SSM by deploy-on-merge.sh, never here.

# Compliance gate for the external demo (metron-ops#24, #310). Releasing the external
# demo is a PR that flips this line — and only once DISPLAY_LICENCE_CONFIRMED is true on
# the strength of the licence recorded on metron-ops#24; the release gate
# (api/services/external_demo_release_gate.py) pages if the first is true without the
# second.
EXTERNAL_DEMO_RELEASED=false
DISPLAY_LICENCE_CONFIRMED=false

# Direct-Anthropic linkage retired fleet-wide (2026-08-29 ruling, metron-ops-I281). No
# Metron code reads it; a copy left on the box from before the ruling is removed here.
-ANTHROPIC_API_KEY
